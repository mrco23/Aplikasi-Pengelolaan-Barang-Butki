# Salin menjadi .env. Hanya variabel berawalan VITE_ yang terbaca frontend.
# Supabase Dashboard → Project Settings → API (Project URL & anon/publishable key).
# Kunci anon aman di frontend karena dijaga RLS. JANGAN taruh service_role key di sini.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Domain email buatan untuk login berbasis username (harus sama dengan AUTH_EMAIL_DOMAIN di supabase/.env)
VITE_AUTH_EMAIL_DOMAIN=siber-evidence.local
# Zona waktu tampilan (Manado = WITA)
VITE_APP_TIMEZONE=Asia/Makassar
