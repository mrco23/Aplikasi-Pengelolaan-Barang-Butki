# Salin menjadi .env — HANYA untuk script seed di laptop. Jangan di-commit, jangan dipakai di frontend.
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role / secret key (melewati semua RLS!)
SUPABASE_SERVICE_ROLE_KEY=
# Domain email buatan untuk login berbasis username. Harus sama dengan VITE_AUTH_EMAIL_DOMAIN di fe/.env
AUTH_EMAIL_DOMAIN=siber-evidence.local

# Koneksi langsung ke database untuk npm run db:apply / db:reset.
# Supabase → tombol Connect → Connection String → Session pooler (port 5432). Ganti [YOUR-PASSWORD] dengan password database.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
